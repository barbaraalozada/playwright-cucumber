{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "scripts": {
    "test": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:tags": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --tags",
    "test:chromium": "BROWSER=chromium npm test",
    "test:firefox": "BROWSER=firefox npm test",
    "test:all-browsers": "npm run test:chromium && npm run test:firefox",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.8",
    "allure-commandline": "^2.36.0",
    "allure-cucumberjs": "^3.4.5",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "dotenv": "^17.2.3"
  }
}
