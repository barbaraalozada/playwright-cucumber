{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "scripts": {
    "test": "npx cucumber-js",
    "smoke": "npm run test -- --tags '@smoke'",
    "regression": "npm run test -- --tags 'not @wip and not @skip'",
    "smoke:chromium": "BROWSER=chromium npm run smoke",
    "smoke:firefox": "BROWSER=firefox npm run smoke",
    "regression:chromium": "BROWSER=chromium npm run regression",
    "regression:firefox": "BROWSER=firefox npm run regression",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.8",
    "allure-commandline": "^2.36.0",
    "allure-cucumberjs": "^3.4.5",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "dotenv": "^17.2.3"
  }
}
